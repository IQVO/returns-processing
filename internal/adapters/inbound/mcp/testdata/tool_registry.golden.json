              "product_class",
              "outcome"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "version": {
          "type": "integer"
        },
        "veto_outcome": {
          "type": "string"
        }
      },
      "required": [
